<resources>
    <string name="app_name">ADB 看门狗</string>
    <string name="a11y_description">当安全设置标志未被系统接受时，通过设置界面自动重新打开无线调试。</string>
    <string name="a11y_summary">无线调试的界面兜底恢复</string>

